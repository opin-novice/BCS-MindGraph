# BCS Temporal MCQ pipeline -- required/optional environment variables.
# Copy this file to .env and fill in real values. See hf_client.py's
# module docstring for the full HF_* contract.

# --- Hugging Face Inference (required for any LLM-backed generation step) ---
# Either name works; HF_API_TOKEN is HF's own convention, HF_API_KEY
# matches this project's older naming. Create a token at
# https://huggingface.co/settings/tokens
HF_API_KEY=
HF_API_TOKEN=

# Optional extra tokens for round-robin/failover across quota limits.
# HF_API_KEY_1=
# HF_API_KEY_2=

# Optional. Defaults to Qwen/Qwen2.5-72B-Instruct.
# HF_MODEL=

# Optional. Set instead of HF_MODEL if using a dedicated HF Inference Endpoint.
# HF_ENDPOINT_URL=

# Optional. Inference Providers routing. Defaults to "auto".
# HF_PROVIDER=

# Optional. Retry tuning for quota/rate-limit handling.
# HF_QUOTA_MAX_RETRIES=3
# HF_QUOTA_RETRY_DELAY_SECONDS=20

# Optional. Per-request timeout in seconds before a stalled call is
# retried instead of hanging indefinitely.
# HF_REQUEST_TIMEOUT_SECONDS=60

# --- Google Programmable Search (used by web_scraper.py for source lookup) ---
# Required only for scripts that call WebScraper's Google CSE path
# (e.g. batch02_ra_sourcing.py, pilot_evidence_intake.py).
GOOGLE_API_KEY=
GOOGLE_CSE_ID=
