{"claim_id": "BCSGK-0336-D", "claim_scope_match": "pending_reviewer", "evidence_id": "EV_PILOT_000008", "fact_id": "BCSGK-0336", "leakage_verdict": "pending_reviewer", "link_id": "LNK_BCSGK-0336-D_EV_PILOT_000008", "object_match": "বাগেরহাট", "predicate_match": "located_in", "review_status": "pending_reviewer", "reviewer_id": null, "semantic_verdict": "pending_reviewer", "subject_match": "মহিষ প্রজনন ও উন্নয়ন খামার", "support_role": "primary_support", "supporting_excerpt": "ও অগ্নি ছিল তাদের অন্যতম উপাস্য। আর্য ও অনার্য উভয় ধর্মের আচার অনুষ্ঠান রীতিনীতির মিশ্রণে প্রতিষ্ঠিত হয় হিন্দুধর্ম। বাগেরহাটের অতি প্রাচীন স্থান পানিঘাটে প্রাপ্ত কষ্টি পাথরের অষ্টাদশ ভূজা দেবীমূর্তি, মরগা খালের তীরে খানজাহান আলী এর পাথর ভর্তি জাহাজ ভিড়বার স্থান জাহাজঘাটায় মাটিতে গ্রোথিত পাথরে উৎকীর্ণ অষ্টাদশ ভূজা মহিষ মর্দিনী দেবীমূর্তি, চিতলমারী উপজেলাধীন খরমখালি গ্রামে প্রাপ্ত কৃষ্ণ প্রস্তরের বিষ্ণু মূর্তি ইত্যাদি নিদর্শন এখানে হিন্দু সভ্যতা বিকাশের পরিচয় বহন করে। ১৪৫০ খ্রিঃ খানজাহান আলী খাঞ্জেলী দীঘি খনন করান। এ সময় অনন্য সাধারণ ধ্যাণী বৌদ্ধমূর্তি পাওয়া যায়। ১৯৭১ সালে বৌদ্ধ পুরোহিত বিশুদ্ধানন্দ মহাথেরো পাল আমলে নির্মিত ঐ বৌদ", "temporal_field_name": "mediawiki_revision_timestamp", "temporal_raw_value": "2023-04-15T03:54:48Z", "temporal_verdict": "pending_reviewer", "unsupported_qualifiers": [], "valid_from": null, "valid_to": null}
